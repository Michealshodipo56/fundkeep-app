# Create a copy of this file named .env.local and fill in the values below.
# All NEXT_PUBLIC_ variables are exposed to the browser — do not put secrets in them.

# The deployed FundKeep Soroban contract address (see fundkeep-contract/scripts/deploy.sh).
NEXT_PUBLIC_CONTRACT_ID=

# The SAC (Stellar Asset Contract) address of the USDC token to save. Verify
# this is still live on testnet before using it — see fundkeep-contract's
# deploy script for how to check.
NEXT_PUBLIC_USDC_CONTRACT_ID=CDLZFC3SYJYDVR72W5SCVNVV45XMCHZDBNDVLYZ2G7SFKNEPFBYSYTRU

# "testnet" or "mainnet" — controls which network passphrase the SDK uses.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC endpoint. Defaults to the public testnet RPC if unset.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Base URL of a running fundkeep-indexer instance, used for the activity feed
# and cross-device goal sync. Leave blank to fall back to local-only storage.
NEXT_PUBLIC_INDEXER_URL=
