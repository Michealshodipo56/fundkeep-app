# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# All NEXT_PUBLIC_ variables are baked into the browser bundle.
# Do not put private keys, seed phrases, or server secrets here.

# Deployed FundKeep Soroban contract (testnet).
NEXT_PUBLIC_CONTRACT_ID=CBYUMUNDBGT5JTYX62SSFH5NTK2ELLRT2PP3LLZOI757JB4BULDDDFAH

# USDC Stellar Asset Contract used by that deployment.
NEXT_PUBLIC_USDC_CONTRACT_ID=CCUWRYBOQTKMKTBLBJX5ZOZ2ZGCL7Z4ODNDB53DIPI4XMB4XBONY6G6X

# "testnet" or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Indexer API base URL (no trailing slash).
# Local: http://localhost:4000
# Production: your Render indexer URL, e.g. https://fundkeep-indexer.onrender.com
NEXT_PUBLIC_INDEXER_URL=
